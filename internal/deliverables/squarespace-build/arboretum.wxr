		<dc:creator><![CDATA[BrianSapp-Moore]]></dc:creator>
		<guid isPermaLink="false">https://allsaintsconcord.org/?p=10832</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:heading {"level":4} -->
<h4>Southern Magnolia (Magnolia grandiflora)</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p><em>Given in thanksgiving for Alan, Jay, and Lane Erickson, by their parents, John and Jo Erickson.</em></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>1994</p>
<!-- /wp:paragraph -->]]></content:encoded>
