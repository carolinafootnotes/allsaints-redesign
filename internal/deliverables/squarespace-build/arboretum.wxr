		<category domain="post_tag" nicename="jack"><![CDATA[jack]]></category>
		<category domain="category" nicename="memorial-arboretum"><![CDATA[Memorial Arboretum]]></category>
						<wp:postmeta>
		<wp:meta_key><![CDATA[_edit_last]]></wp:meta_key>
		<wp:meta_value><![CDATA[9]]></wp:meta_value>
